{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "noEmit": false
  },
  "include": [
    "src/types.ts",
    "src/data.ts",
    "src/enhancedTypes.ts",
    "src/enhancedData.ts",
    "src/domain.ts",
    "src/analytics.ts",
    "src/featureFlags.ts",
    "src/budget.ts",
    "src/constraints.ts",
    "src/productLinks.ts",
    "src/assetUrl.ts",
    "src/runtimeEnv.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}