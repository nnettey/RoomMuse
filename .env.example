OPENAI_API_KEY=your_key_here
PORT=3201
ROOMMUSE_DATA_DIR=%LOCALAPPDATA%\RoomMuse\storage

# Optional. scripts/start-roommuse.ps1 derives this from your Wi-Fi address when it is unset,
# which is more reliable than a hand-edited IP that goes stale.
# EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:3201

# One text model serves room analysis, live product search, and citation-constrained parsing.
# OPENAI_TEXT_MODEL=gpt-5.6-luna
# Per-role pins, each defaulting to OPENAI_TEXT_MODEL.
# OPENAI_ANALYSIS_MODEL=
# OPENAI_PRODUCT_SEARCH_MODEL=
# OPENAI_PRODUCT_PARSE_MODEL=

# The room render must be an image model: /v1/images/edits rejects text models.
# OPENAI_IMAGE_MODEL=gpt-image-2
